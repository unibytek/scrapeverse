{
  "name": "scrapeverse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate && prisma migrate deploy",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components scripts lib",
    "lint:fix": "eslint app components scripts lib --fix",
    "scrape": "npx tsx --env-file=.env scripts/scrape.ts",
    "format": "prettier \"app/**\" \"components/**\" \"scripts/**\" \"lib/**\" --write",
    "prepare": "husky"
  },
  "lint-staged": {
    "app/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "components/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "scripts/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ],
    "lib/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@brightdata/sdk": "^1.2.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@prisma/client": "^6.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.9",
    "next": "^16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "prisma": "^6.12.0",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
